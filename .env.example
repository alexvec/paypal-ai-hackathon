# Copy to .env for local runs and `npm run proof`. Never commit real values.
# When a required variable is missing, the app and the proof say "not connected" and name it.
# There is no mock mode and no fallback.

# Required for anything that touches PayPal. Sandbox credentials from a REST app on
# https://developer.paypal.com/dashboard/applications/sandbox
# The host is fixed to https://api-m.sandbox.paypal.com in src/lib/config.ts. No variable changes it.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Required for the model. Vercel AI Gateway key. Locally, a VERCEL_OIDC_TOKEN pulled by
# `vercel env pull` works instead.
AI_GATEWAY_API_KEY=

# Optional. Defaults to deepseek/deepseek-v4.1-flash through the gateway.
LLM_MODEL=
