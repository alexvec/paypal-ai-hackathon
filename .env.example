# Copy to .env.local for local runs, or add in Vercel: Project, Settings, Environment Variables.
# Each integration picks its mode from these variables at runtime. No code change is needed.
# With nothing set, the app runs in its labelled mock and canned modes.
# Never commit real values.

# PayPal. Both must be set to leave mock mode. The app always targets the PayPal sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# LLM. The model must support tool calling and image input.
# Vercel AI Gateway is the default. On Vercel it uses the project's OIDC token, so no key is needed.
# Locally, run `vercel env pull` to get a token (valid about 12 hours), or set AI_GATEWAY_API_KEY.
AI_GATEWAY_API_KEY=
# A direct provider key takes priority over the gateway.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional. "gateway", "anthropic" or "openai".
LLM_PROVIDER=
# Optional. Overrides the default model id for the chosen provider.
LLM_MODEL=

# Optional. Policy limits enforced in code. Defaults: 5000 and USD,EUR,GBP.
POLICY_MAX_INVOICE_AMOUNT=
POLICY_ALLOWED_CURRENCIES=
